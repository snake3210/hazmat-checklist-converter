@echo off
chcp 65001 >nul
title 公共危險物品自主檢查表 - 拖曳檔案自動轉換
cd /d "%~dp0"

echo =================================================================
echo   公共危險物品場所自主檢查表 - 拖曳檔案自動轉換
echo =================================================================
echo.

if "%~1"=="" (
    echo [使用說明]
    echo 您可以將一個或多個 .docx 檔案，或是放有檢查表的資料夾，
    echo 直接用滑鼠「拖曳」到這個圖示上方放開，程式就會自動為您轉換！
    echo.
    echo 偵測到您目前是用雙擊開啟：
    echo 是否要直接執行「路竹30倍以上-16家ok」資料夾的批次轉換？
    echo.
    set /p choice="請輸入 Y 開始轉換，或按 N 離開 (Y/N): "
    if /i "%choice%"=="Y" (
        python convert_signature.py
    ) else (
        exit /b
    )
) else (
    python convert_signature.py %*
)

echo.
echo =================================================================
echo 處理完畢，請按任意鍵關閉視窗...
pause >nul
